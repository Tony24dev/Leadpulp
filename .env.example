# ─── Apify ───────────────────────────────────────────────────────────────────
# Get your API key from: https://console.apify.com/account/integrations
APIFY_API_KEY=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Get your keys from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) while building, live keys (sk_live_...) for production
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Stripe Price IDs ────────────────────────────────────────────────────────
# 1. Go to https://dashboard.stripe.com/products
# 2. Create three products (Starter $49, Growth $149, Agency $299)
# 3. Set pricing as "One-time" for each
# 4. Copy the Price ID (starts with price_) for each and paste below
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_AGENCY=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
